# ElevenLabs: used for both speech-to-text (Scribe realtime) and text-to-speech
ELEVENLABS_API_KEY=
# Optional. Defaults to "Sarah" (EXAVITQu4vr4xnSDxMaL)
ELEVENLABS_VOICE_ID=
# Optional. Defaults to eleven_flash_v2_5 (lowest latency)
ELEVENLABS_TTS_MODEL=

# Google AI Studio key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Optional. Flash-Lite has the most generous free-tier daily quota.
GEMINI_MODEL=gemini-3.5-flash-lite

# Comma-separated origins allowed to call the API, e.g. https://your-app.vercel.app
CORS_ORIGINS=*
CLINIC_TIMEZONE=Asia/Kolkata
# Concurrent calls allowed, and a hard cap per call (protects your API quota)
MAX_SESSIONS=3
MAX_CALL_SECS=600
# Optional JSON list of ICE servers (add TURN if WebRTC fails behind strict NAT)
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
